####################################################################################################################
# Nouns & Person groups - Personengruppen & Hauptwörter 2FNN
# 2: suffix for nouns
# F: flag, whereby 1 corresponds to person groups, 2 to other nouns, 3 a list of regular suffixes that appear over and over again, 
#  9 is to mark irregular plural forms, unkown or not yet defined
# NN: enumeration
####################################################################################################################


# Nouns that refer to groups of persons (Personengruppen regelmäßig)
SFX 2101 Y 2
SFX 2101   er      e           .
SFX 2101   er      a           .


# Nouns that refer to persons (Personen, bei denen die weibliche Form mit "e" gebildet wird) - "e" corresponds to female singular, "enna" corresponds to female plural, male is the same for singular and plural
SFX 2102 Y 2
SFX 2102   0       e           .
SFX 2102   0       enna        .


# Standard plural form: adding "a" Nouns for which the plural form is built by adding "a" (Mehrzahlformen, die mit "a" am Ende gebildet werden)
SFX 2200 Y 4
SFX 2200   0       a           [^e]
SFX 2200   e       a           ie        # examples: Battrie, Energie (it might make sense to write "Battriea" and "Energiea"
SFX 2200   e       a           [^i]e
SFX 2200   ë       a           ë




# Nouns for which the plural form is built by adding "s", usually words taken from English language (Mehrzahlformen, die mit "s" am Ende gebildet werden)
SFX 2204 Y 1
SFX 2204   0       s           .


# Nouns for which the plural form is built by adding "e" (Mehrzahlformen, die mit "e" am Ende gebildet werden)
SFX 2205 Y 1
SFX 2205   0       e           .


# Nouns for which the plural form is built by adding "er" (Mehrzahlformen, die mit "er" am Ende gebildet werden)
SFX 2206 Y 1
SFX 2206   0       er          .


# Nouns for which the plural form is built by changing "el" to "la" (Mehrzahlformen, die mit "la" am Ende gebildet werden)
SFX 2207 Y 1
SFX 2207   el       la          


# Nouns for which the plural form is built by adding "ta" (Mehrzahlformen, die mit "ta" am Ende gebildet werden)
SFX 2208 Y 1
SFX 2208   0        ta          .


# Nouns for which the plural form is built by adding "ena" (Mehrzahlformen, die mit "ena" am Ende gebildet werden)
SFX 2209 Y 1
SFX 2209   0        ena         .


# Nouns for which the plural form is built by changing "tom" to "tümer" (Mehrzahlformen, bei denen "tom" zu "tümer" wird)
SFX 2210 Y 3
SFX 2210   tom      tümer       .
SFX 2210   nis      nisse       .
SFX 2210   uss      üss         .


# Nouns for which the plural form is built by adding "na", e.g. Stadio, (Mehrzahlformen, bei denen "na" angehängt wird, weil man das "n" in der Einzahlform weglässt beim aussprechen)
SFX 2211 Y 1
SFX 2211   0        na          .


# Nouns that refer to languages (auf Englisch, em Englischa, ens Englische)
SFX 2800 Y 2
SFX 2800   0        a           .
SFX 2800   0        e           .





####################################################################################################################
# Adjectives - Eigenschaftswörter (Adjektive) 3FNN
# 3: suffix for adjectives
# F: flag, whereby 0 corresponds to the case that the adjective is regular, 1 means either a) the plural does not 
#  exist semantically or b) is unregular 2 means the singular does not exist (should rarely be the case), 3 all 
#  other cases 
# NN: enumeration
#
# Generally speaking, the negations (built with "o" as a prefix) are listed in the dic file separately
####################################################################################################################
####################################################################################################################


# adjectives regular, including comparative & superlative degrees and including negation (Eigenschaftswörter regulär)
# this also includes nationalities, e.g. deutsch, britisch, europäisch, etc.
SFX 3001 Y 13
SFX 3001   0       0            .
SFX 3001   0       a            .
SFX 3001   0       am           .
SFX 3001   0       e            .
SFX 3001   0       s            .
SFX 3001   0       er           .
SFX 3001   0       ere          .
SFX 3001   0       era          .
SFX 3001   0       ers          .
SFX 3001   0       ste          .
SFX 3001   0       sta          .
SFX 3001   0       sts          .
SFX 3001   0       ster         .


# adjectives regular, including comparative & superlative degrees and including negation (Eigenschaftswörter, die auf "a", "d", "s", oder "x" enden)
SFX 3002 Y 25
SFX 3002   0       0            .
SFX 3002   0       a            [^a]
SFX 3002   a       ena          a
SFX 3002   0       am           [^a]
SFX 3002   a       enam         a
SFX 3002   0       e            [^a]
SFX 3002   a       ene          a
SFX 3002   a       es           [^s]
SFX 3002   0       es           s
SFX 3002   0       er           [^a]
SFX 3002   a       ener         a
SFX 3002   0       ere          [^a]
SFX 3002   0       nere         a
SFX 3002   0       era          [^a]
SFX 3002   0       nera         a
SFX 3002   0       ers          [^a]
SFX 3002   0       ners         a
SFX 3002   0       este         [^a]
SFX 3002   a       este         a
SFX 3002   0       esta         [^a]
SFX 3002   a       esta         a
SFX 3002   0       estas        [^a]
SFX 3002   a       estas        a
SFX 3002   0       ester        [^a]
SFX 3002   a       ester        a


# adjectives that end by "t", including comparative & superlative degrees and including negation (Eigenschaftswörter, die auf  "t" enden und regulär sind, 20=t)
SFX 3020 Y 12
SFX 3020   0       a            .
SFX 3020   0       am           .
SFX 3020   0       e            .
SFX 3020   0       s            .
SFX 3020   0       er           .
SFX 3020   0       ere          .
SFX 3020   0       era          .
SFX 3020   0       ers          .
SFX 3020   0       este         .
SFX 3020   0       esta         .
SFX 3020   0       estas        .
SFX 3020   0       ester        .







# adjectives regular, including comparative & superlative degrees and including negation (Eigenschaftswörter, die auf "el" enden und regulär sind)
SFX 3003 Y 12
SFX 3003   el      la           .
SFX 3003   el      lam          .
SFX 3003   el      le           .
SFX 3003   0       s            .
SFX 3003   el      ler          .
SFX 3003   el      lere         .
SFX 3003   el      lera         .
SFX 3003   el      lers         .
SFX 3003   0       ste          .
SFX 3003   0       sta          .
SFX 3003   0       stas         .
SFX 3003   0       ster         .


# adjectives without comparative & superlative degrees (Eigenschaftswörter die "einzahlig", also nicht steigerbar sind bzw. es keine Mehrzahlform gibt), the plural either (1) does not exist semantically or (2) is unregular
# examples: zwôestimmig (Musikinstrument), warm, benannt
SFX 3104 Y 6
SFX 3104   0       a            .
SFX 3104   0       am           .
SFX 3104   0       e            .
SFX 3104   0       s            [^sx]
SFX 3104   0       as           [sx]      # jedas should be recognized here
SFX 3104   0       er           .


# building superlative degrees of adjectives in comparative form (Eigenschaftswörter Mehrzahl), either (1) the singular is unregular or (2) the singular does not exist (should rarely be the case)
# Examples: wärmer, später
SFX 3205 Y 8
SFX 3205   0       a            .        # examples of first case: letzt
SFX 3205   0       er           .
SFX 3205   0       e            .
SFX 3205   0       s            .
SFX 3205   er      sta          .
SFX 3205   er      ste          .
SFX 3205   er      sts          .
SFX 3205   er      ster         .


# plural form of irregular adjectives (Eigenschaftswörter unregelmäßig  Mehrzahl), only comparative & superlative degrees, either (1) the singular is unregular or (2) the singular does not exist (should rarely be the case)
SFX 3206 Y 7
SFX 3206   0       a            .
SFX 3206   0       er           .
SFX 3206   0       e            .
SFX 3206   0       s            .
SFX 3206   er      este         .
SFX 3206   er      esta         .
SFX 3206   er      estas        .



