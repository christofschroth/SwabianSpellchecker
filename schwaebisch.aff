####################################################################################################################
# Verbs/Tunwörter: generally speaking, the past tense is defined separately to make it easier to build compunds
# 1FNN
# 1: refers to suffixes of verbs
# F: 0 corresponds to present tense, 1 to past tense, 2 for irregular verbs, 3 to dummy (used for development 
#  purposes only)
# NN: number of rule 
####################################################################################################################
 

# regular verbs (Tunwörter regelmäßig) - present tense
SFX 1000 Y 4
SFX 1000   a       0           .
SFX 1000   a       st          .
SFX 1000   a       t           .
SFX 1000   a       at          .


# present tense of verbs that end by "da" or "na" (Tunwörter, die auf "da" enden, 4=d), some other verbs also fall in this rule
SFX 1004 Y 3
SFX 1004   a       e           .
SFX 1004   a       est         .
SFX 1004   a       at          .


# present tense of verbs that end by "iga" (Tunwörter, die auf "iga" enden, 9=i)
# this is almost the same to the regular case, only 1st person singular differs
# Note, that some other verbs that end by "iga" are still regular
# Note, that verbs ending by "era" (but not by "iera") follow the same rule  
SFX 1009 Y 4
SFX 1009   a       e           .
SFX 1009   a       st          .
SFX 1009   a       t           .
SFX 1009   a       at          .


# present tense of verbs that end by "la" (Tunwörter, die auf "la" enden, 12=l)
# needs a double check
SFX 1012 Y 5
SFX 1012  la       le          .    # checked, passt (Befehlsform 1. Person)
SFX 1012  la       el          .    # needs double check
SFX 1012  la       lest        .    # needs double check
SFX 1012  la       lt          .    # needs double check
SFX 1012  la       lat         .    # checked, passt (3. Person Plural)


# present tense of verbs that end by "era", but not by "iera" (Tunwörter, die auf "era" enden, 18=r)
SFX 1018 Y 5
SFX 1018   a       e           .
SFX 1018   a       0           .
SFX 1018   a       st          .
SFX 1018   a       t           .
SFX 1018   a       at          .


# present tense of verbs that end by "sa", "za", or "ßa" (Tunwörter, die auf "sa" enden, 19=s)
SFX 1019 Y 3
SFX 1019   a       0           .
SFX 1019   a       t           .
SFX 1019   a       at          .


# present tense of verbs that end by "ta" (Tunwörter, die auf "ta" enden, 20=t)
SFX 1020 Y 4
SFX 1020   a       0           .
SFX 1020   a       e           .
SFX 1020   a       est         .
SFX 1020   a       at          .


# conjunctive form of verbs (Möglichkeitsformen bzw. Konjunktiv 2 Konstruktionen, 03=c)
SFX 1103 Y 3
SFX 1103   0       est         .
SFX 1103   0       t           [^t]
SFX 1103   0       e           .




